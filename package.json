{
  "name": "ynaiudan",
  "private": true,
  "version": "0.1.0",
  "description": "YnAiUdan - production-grade multimodal AI agent platform",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @ynaiudan/web --filter @ynaiudan/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:format": "prisma format --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
