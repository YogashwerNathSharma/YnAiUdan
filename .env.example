NODE_ENV=development
PORT=4000
HOST=0.0.0.0
DATABASE_URL=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/ynaiudan?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CORS_ORIGIN=http://localhost:5173
WORKSPACE_ROOT=.ynaiudan-workspaces
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-5.5
GITHUB_TOKEN=replace-with-your-github-token
# Required for GitHub write operations. Comma-separated owner/repository names.
GITHUB_ALLOWED_REPOSITORIES=YogashwerNathSharma/YnAiUdan
