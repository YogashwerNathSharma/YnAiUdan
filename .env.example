NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# MongoDB Atlas connection string. Keep the real URI in local/deployment secrets only.
DATABASE_URL=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/ynaiudan?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CORS_ORIGIN=http://localhost:5173
# Real AI provider. Never commit the real key.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-5.5
