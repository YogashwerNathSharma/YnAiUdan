NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# MongoDB Atlas connection string. Keep the real URI in local/deployment secrets only.
DATABASE_URL=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/ynaiudan?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Real AI provider. Never commit the real key.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
# Optional: Groq provider (used first by the coding agent if set).
GROQ_API_KEY=
# Optional: LOCAL AI server on YOUR PC (Ollama / LM Studio / llama.cpp).
# OpenAI-compatible, no API key, no cloud token limits. When set, the coding
# agent uses it FIRST. For Ollama: run `ollama serve`, then `ollama pull qwen2.5-coder:3b`.
#   LOCAL_AI_BASE_URL=http://localhost:11434/v1   (Ollama)
#   LOCAL_AI_BASE_URL=http://localhost:1234/v1    (LM Studio)
LOCAL_AI_BASE_URL=
LOCAL_AI_MODEL=qwen2.5-coder:3b
# Model the autonomous coding agent should use (provider-prefixed, e.g. groq:llama-3.3-70b-versatile).
AI_CODING_MODEL=openai:gpt-4o-mini
# GitHub personal access token or GitHub App token. Keep the real token in deployment secrets only.
GITHUB_TOKEN=replace-with-your-github-token
# IMPORTANT: Folder the Computer Access panel + coding agent can read/edit.
# Point this at the project you want the AI to work on. Without it, an empty
# sandbox folder (.ynaiudan-workspaces) is used and the panel shows "No files yet".
# Example (Windows): WORKSPACE_ROOT=C:\Users\Admin\YnAiUdan
WORKSPACE_ROOT=
