generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Tenant {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name String
  slug String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users User[]
  projects Project[]
  tasks Task[]
  memories Memory[]
  queueJobs TaskQueueJob[]
  aiUsage AiUsage[]
}
model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  tenantId String @db.ObjectId
  email String @unique
  passwordHash String
  displayName String
  role UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade)
  projects ProjectMember[]
  conversations Conversation[]
  tasks Task[]
  memories Memory[]
  aiUsage AiUsage[]
  @@index([tenantId])
}
model Project {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  tenantId String @db.ObjectId
  name String
  slug String
  instructions String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade)
  members ProjectMember[]
  conversations Conversation[]
  tasks Task[]
  memories Memory[]
  @@unique([tenantId, slug])
  @@index([tenantId])
}
model ProjectMember { id String @id @default(auto()) @map("_id") @db.ObjectId projectId String @db.ObjectId userId String @db.ObjectId role ProjectRole @default(MEMBER) project Project @relation(fields:[projectId], references:[id], onDelete:Cascade) user User @relation(fields:[userId], references:[id], onDelete:Cascade) @@unique([projectId,userId]) @@index([userId]) }
model Conversation { id String @id @default(auto()) @map("_id") @db.ObjectId projectId String? @db.ObjectId userId String @db.ObjectId title String @default("New conversation") createdAt DateTime @default(now()) updatedAt DateTime @updatedAt project Project? @relation(fields:[projectId], references:[id], onDelete:SetNull) user User @relation(fields:[userId], references:[id], onDelete:Cascade) messages Message[] @@index([userId,updatedAt]) @@index([projectId,updatedAt]) }
model Message { id String @id @default(auto()) @map("_id") conversationId String @db.ObjectId role MessageRole content String model String? createdAt DateTime @default(now()) conversation Conversation @relation(fields:[conversationId], references:[id], onDelete:Cascade) @@index([conversationId,createdAt]) }
model Memory { id String @id @default(auto()) @map("_id") tenantId String @db.ObjectId userId String @db.ObjectId projectId String? @db.ObjectId type MemoryType key String value String importance Float @default(0.5) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade) user User @relation(fields:[userId], references:[id], onDelete:Cascade) project Project? @relation(fields:[projectId], references:[id], onDelete:SetNull) @@index([tenantId,userId,updatedAt]) @@index([projectId,importance,updatedAt]) @@index([type,updatedAt]) }
model Task { id String @id @default(auto()) @map("_id") @db.ObjectId tenantId String @db.ObjectId userId String @db.ObjectId projectId String? @db.ObjectId title String goal String status TaskStatus @default(QUEUED) autonomyMode AutonomyMode @default(ASK_BEFORE_TOOLS) maxSteps Int? maxToolCalls Int? maxExecutionMs Int? maxRetries Int? @default(3) startedAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade) user User @relation(fields:[userId], references:[id], onDelete:Cascade) project Project? @relation(fields:[projectId], references:[id], onDelete:SetNull) steps TaskStep[] queueJobs TaskQueueJob[] @@index([tenantId,status]) @@index([userId,createdAt]) }
model TaskStep { id String @id @default(auto()) @map("_id") @db.ObjectId taskId String @db.ObjectId sequence Int? name String? stepNumber Int? type TaskStepType? status StepStatus @default(PENDING) input Json? output Json? error String? retryCount Int @default(0) startedAt DateTime? completedAt DateTime? task Task @relation(fields:[taskId], references:[id], onDelete:Cascade) @@index([taskId]) }
model TaskQueueJob { id String @id @default(auto()) @map("_id") taskId String @db.ObjectId status QueueJobStatus @default(QUEUED) attempts Int @default(0) createdAt DateTime @default(now()) startedAt DateTime? finishedAt DateTime? error String? tenantId String @db.ObjectId tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade) task Task @relation(fields:[taskId], references:[id], onDelete:Cascade) @@index([status,createdAt]) @@index([tenantId,status]) @@index([taskId]) }
model AiUsage { id String @id @default(auto()) @map("_id") tenantId String @db.ObjectId userId String @db.ObjectId taskType String provider String model String inputTokens Int @default(0) outputTokens Int @default(0) latencyMs Int success Boolean createdAt DateTime @default(now()) error String? tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade) user User @relation(fields:[userId], references:[id], onDelete:Cascade) @@index([tenantId,createdAt]) @@index([userId,createdAt]) @@index([model,createdAt]) }
enum UserRole { OWNER ADMIN DEVELOPER USER AGENT }
enum ProjectRole { OWNER EDITOR MEMBER VIEWER }
enum MessageRole { USER ASSISTANT SYSTEM TOOL }
enum MemoryType { CONVERSATION USER PROJECT TASK TOOL PREFERENCE }
enum TaskStatus { QUEUED PLANNING RUNNING WAITING_APPROVAL PAUSED FAILED COMPLETED CANCELLED }
enum StepStatus { PENDING RUNNING COMPLETED FAILED SKIPPED }
enum TaskStepType { PLAN TOOL VALIDATION RESULT }
enum AutonomyMode { CHAT_ONLY SUGGEST_ACTIONS ASK_BEFORE_TOOLS AUTO_SAFE AUTONOMOUS FULLY_CONTROLLED }
enum QueueJobStatus { QUEUED RUNNING COMPLETED FAILED }
